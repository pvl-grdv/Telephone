          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie eine HTTPS-Adresse oder aktivieren Sie HTTP über Tailscale für eine IPv4-Adresse aus 100.64.0.0/10 mit explizitem Port. Das Gateway-Token wird für diese Adresse im Schlüsselbund gespeichert; lassen Sie das Feld leer, um es zu behalten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите адрес HTTPS либо включите HTTP через Tailscale для IPv4-адреса из 100.64.0.0/10 с явным портом. Токен gateway хранится в Keychain для этого адреса; оставьте поле пустым, чтобы сохранить его."
          }
        }
      }
