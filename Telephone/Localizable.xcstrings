    "The address has changed. Enter its device token, or reuse the saved token only if both addresses belong to the same gateway.": {
      "comment": "CRM gateway connection settings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address has changed. Enter its device token, or reuse the saved token only if both addresses belong to the same gateway."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse wurde geändert. Geben Sie ihr Geräte-Token ein oder verwenden Sie das gespeicherte Token nur dann erneut, wenn beide Adressen zum selben Gateway gehören."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес изменён. Введите его токен устройства или используйте сохранённый токен, только если оба адреса ведут к одному gateway."
          }
        }
      }
    },
    "This token connects Telephone to the gateway. It is not your CRM password or a Tailscale login. Once saved for this address, it can be left blank.": {
      "comment": "CRM gateway connection settings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This token connects Telephone to the gateway. It is not your CRM password or a Tailscale login. Once saved for this address, it can be left blank."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Token verbindet Telephone mit dem Gateway. Es ist weder Ihr CRM-Passwort noch eine Tailscale-Anmeldung. Nach dem Speichern für diese Adresse kann das Feld leer bleiben."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот токен подключает Telephone к gateway. Это не пароль CRM и не вход в Tailscale. После сохранения токена для этого адреса поле можно оставлять пустым."
          }
        }
      }
    },
